# SentinelAI Backend Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env or secrets to git)

# Application metadata
APP_NAME=SentinelAI
APP_VERSION=0.1.0
APP_DESCRIPTION="Intelligent Cloud Security & DevSecOps Platform"

# Environment: "development", "staging", "production"
ENVIRONMENT=development
DEBUG=false

# API Prefix
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Trivy Vulnerability Scanner Settings
TRIVY_BINARY_PATH=trivy
TRIVY_CACHE_DIR=D:\SentinelAI\.cache\trivy
SCAN_TIMEOUT_SECONDS=120
APPROVED_SCAN_IMAGES=["python:3.12-slim","alpine:3.19","nginx:alpine","redis:alpine"]
